            <friction>
              <ode><mu>0.4</mu><mu2>0.4</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="wall_seg_23_visual">
          <pose>0 -0.079199 0.295573 -6.021386 0 0</pose>
          <geometry>
            <box><size>2.0000 0.083794 0.0120</size></box>
          </geometry>
          <material>
            <ambient>0.35 0.34 0.32 1</ambient>
            <diffuse>0.4 0.39 0.36 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

  
    <!-- Added by Drift: a fixed camera looking at the origin, so the scene can be
         checked visually after it launches. Inert — static, no collisions, no
         dynamics; it does not affect the simulation. Safe to delete if you do not
         want it, though Drift will not be able to show you the running scene. -->
    <model name="drift_scene_view">
      <static>true</static>
      <pose>3 0 2 0 0.34 3.14159</pose>
      <link name="link">
        <sensor type="camera" name="drift_scene_view_camera">
          <topic>/drift/scene_view</topic>
          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <camera>
            <horizontal_fov>1.0472</horizontal_fov>
            <image>
              <width>800</width>
              <height>600</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>100</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>

    <!-- Drift render-confirm: the Sensors system renders camera sensors (ogre2,
         headless-capable) so the observer can read a frame. Added independently of
         the other system plugins — a world often has SceneBroadcaster (pose) but no
         Sensors (no camera), and the injected render-confirm camera needs it. -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Required for the AGOS IMU (agos_imu) to actually publish data on
         imu/data -- without this world-level system plugin, the IMU sensor
         topic exists but stays silent. -->
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
</world>
</sdf>
