<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="pipe_world">

    <!-- ===================== Physics & required systems ===================== -->
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
        </solver>
      </ode>
    </physics>
    <gravity>0 0 -9.81</gravity>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <!-- ===================== Low-ambient lighting =====================
         Deliberately dim so autonomous navigation and the camera payload
         must rely on onboard sensing (lidar/IMU/RGB-D) rather than a
         brightly-lit scene -- this is an inspection-in-the-dark test rig. -->
    <scene>
      <ambient>0.08 0.08 0.09 1</ambient>
      <background>0.02 0.02 0.03 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.15 0.15 0.15 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <direction>-0.3 0.1 -0.9</direction>
      <intensity>0.3</intensity>
    </light>

    <!-- Sparse low-intensity inspection lights along the tunnel interior,
         spaced every 0.5m so the scene is not pitch black but still dim. -->
    <light type="point" name="tunnel_light_1">
      <pose>0.25 0 0.0 0 0 0</pose>
      <diffuse>0.3 0.3 0.28 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <attenuation><range>1.5</range><constant>0.4</constant><linear>0.6</linear><quadratic>0.2</quadratic></attenuation>
      <cast_shadows>false</cast_shadows>
    </light>
    <light type="point" name="tunnel_light_2">
      <pose>1.0 0 0.0 0 0 0</pose>
      <diffuse>0.3 0.3 0.28 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <attenuation><range>1.5</range><constant>0.4</constant><linear>0.6</linear><quadratic>0.2</quadratic></attenuation>
      <cast_shadows>false</cast_shadows>
    </light>
    <light type="point" name="tunnel_light_3">
      <pose>1.75 0 0.0 0 0 0</pose>
      <diffuse>0.3 0.3 0.28 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <attenuation><range>1.5</range><constant>0.4</constant><linear>0.6</linear><quadratic>0.2</quadratic></attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- ===================== Pipe tunnel model =====================
         Inner diameter 600mm (requested range 450-600mm; set to the
         top of that range so the existing 660.4x279.4x406.4mm AGOS chassis,
         diagonal ~493mm, has real clearance). Wall thickness 12mm,
         length 2.0m, axis along world X at 0 deg incline per DRIFT.md.
         Collision/visual is a 24-sided polygon ring of box
         segments -- NEVER a solid cylinder -- so the bore is genuinely hollow
         and the robot rests on the inner floor instead of inside solid rock. -->
    <model name="pipe_tunnel">
      <static>true</static>
      <pose>0 0 0.3060 0 0 0</pose>
      <link name="tunnel_link">
        <collision name="wall_seg_0_collision">
          <pose>0 0.000000 0.306000 -0.000000 0 0</pose>
          <geometry>
            <box><size>2.0000 0.083794 0.0120</size></box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>0.4</mu><mu2>0.4</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="wall_seg_0_visual">
          <pose>0 0.000000 0.306000 -0.000000 0 0</pose>
          <geometry>
            <box><size>2.0000 0.083794 0.0120</size></box>
          </geometry>
          <material>
            <ambient>0.35 0.34 0.32 1</ambient>
            <diffuse>0.4 0.39 0.36 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name="wall_seg_1_collision">
          <pose>0 0.079199 0.295573 -0.261799 0 0</pose>
          <geometry>
            <box><size>2.0000 0.083794 0.0120</size></box>
          </geometry>
