#!/usr/bin/env bash
# AGOS simulation: one command for everything, on Ubuntu with ROS 2 installed
# or through Docker (Windows + WSL, or any Linux with Docker).
#
#   ./agos start              Gazebo + RViz + RTAB-Map + Nav2 (drive with 2D Goal Pose)
#   ./agos explore            the same, plus the autonomous 25 m exploration mission
#   ./agos explore full       the same, but it explores the whole network, then comes back
#   ./agos mission            run the mission in a simulation that is already running
#                             (./agos mission full: the whole network)
#   ./agos teleop             drive with the keyboard (in a second terminal)
#   ./agos stop               stop everything
#   ./agos shell              a terminal with ROS and the workspace ready to use
#   ./agos build              build the workspace (start/explore do this when needed)
#   ./agos check              check the setup: ROS, Gazebo, Nav2, RTAB-Map, graphics
#   ./agos help               more options
#
# Launch options go after the command, e.g.
#   ./agos start gz_gui:=false                  (no Gazebo window: faster, watch in RViz)
#   ./agos start world:=agos_sewer.sdf          (the smaller sewer)
#   ./agos explore leg_length:=15.0
#   ./agos start localization:=true             (reuse the last map)
#
# Where it runs: if ROS 2 is installed (/opt/ros/<distro>), here. If not,
# and Docker is, inside the "agos" container (made from docker/Dockerfile
# the first time, which takes a while). AGOS_DOCKER=1 ./agos ... forces
# Docker; AGOS_DOCKER=0 forces the local install. On Windows, agos.cmd runs
# this script in WSL: double-click it, or type .\agos start in PowerShell.

WS="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
IMAGE=agos-sim:lyrical
CONTAINER=agos
HOME_VOLUME=agos-home
PKG=agos_sim

say() { printf '\033[1;36m[agos]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[agos]\033[0m %s\n' "$*" >&2; }
die() { printf '\033[1;31m[agos]\033[0m %s\n' "$*" >&2; exit 1; }

usage() {
  # the comment at the top of this file
  awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "${BASH_SOURCE[0]}"
  cat <<'EOF'

More:
  ./agos build --clean      delete build/ install/ log/ and build again
  ./agos image              (Docker) rebuild the image after docker/Dockerfile changed
  ./agos reset              (Docker) delete the container and make a fresh one
                            (your files and the last RTAB-Map map are kept)
  ./agos ros2 ...           run any ros2 command, e.g. ./agos ros2 topic list
EOF
}

# ----------------------------------------------------------------- where to run

ros_installed() {
  command -v ros2 > /dev/null 2>&1 && return 0
  ls /opt/ros/*/setup.bash > /dev/null 2>&1
}

use_docker() {
  case "${AGOS_DOCKER:-}" in
    1|yes|true) return 0 ;;
    0|no|false) return 1 ;;
  esac
  [ -f /.dockerenv ] && return 1          # already inside the container
  ros_installed && return 1
  command -v docker > /dev/null 2>&1
}

# ----------------------------------------------------------------- Docker side

docker_image() {
  if [ "${1:-}" = "--rebuild" ] || ! docker image inspect "$IMAGE" > /dev/null 2>&1; then
    say "Building the Docker image $IMAGE (the first time takes 10-30 minutes)"
    docker build -t "$IMAGE" "$WS/docker" || die "docker build failed"
  fi
}

docker_up() {
  docker info > /dev/null 2>&1 || die "Docker is not running. Start Docker Desktop (or: sudo service docker start) and try again."
  docker_image
  if ! docker container inspect "$CONTAINER" > /dev/null 2>&1; then
    # Home folder (~/.ros: ROS logs and RTAB-Map's map) on a Docker volume:
    # much faster than a Windows folder, and kept when the container is reset.
    if ! docker volume inspect "$HOME_VOLUME" > /dev/null 2>&1; then
      docker volume create "$HOME_VOLUME" > /dev/null &&
        docker run --rm --user 0 --volume "$HOME_VOLUME":/home/agos "$IMAGE" \
          chown "$(id -u):$(id -g)" /home/agos > /dev/null
    fi
    local args=(
      --name "$CONTAINER" --detach
      --label agos.folder="$WS"                 # which folder this container is for
      --user "$(id -u):$(id -g)"                # your user id, so files you make stay yours
      --shm-size 2g                             # ROS 2 moves camera images through shared memory
      --volume "$WS":/ws --workdir /ws          # this folder is /ws inside the container
      --volume "$HOME_VOLUME":/home/agos --env HOME=/home/agos
      --volume /tmp/.X11-unix:/tmp/.X11-unix    # windows on your desktop (WSLg / X11)
      --env DISPLAY="${DISPLAY:-:0}"
      --env AGOS_MISSION_DIR=/ws/missions       # mission reports go to missions/ here
    )
    if [ -e /dev/dxg ]; then                    # WSL: the Windows GPU through Direct3D 12
      args+=(--device /dev/dxg --volume /usr/lib/wsl:/usr/lib/wsl:ro)
    elif [ -e /dev/dri ]; then                  # Linux: the GPU through Mesa
      args+=(--device /dev/dri)
    fi
    # Graphics settings set in this shell stay with the container: which GPU
    # to draw on, or none (software rendering). A plain ./agos reset drops them.
    local v
    for v in MESA_D3D12_DEFAULT_ADAPTER_NAME LIBGL_ALWAYS_SOFTWARE; do
      [ -n "${!v:-}" ] && args+=(--env "$v=${!v}")
    done
    docker run "${args[@]}" "$IMAGE" sleep infinity > /dev/null || die "could not create the container"
  fi
  docker start "$CONTAINER" > /dev/null || die "could not start the container (try ./agos reset)"
  # One container serves one practice_agos folder (mounted at /ws). Older
  # containers have no label: for those, at least /ws must have this script.
  local folder
  folder=$(docker container inspect -f '{{index .Config.Labels "agos.folder"}}' "$CONTAINER" 2> /dev/null)
  [ "$folder" = "<no value>" ] && folder=""
  if [ -n "$folder" ] && [ "$folder" != "$WS" ]; then
    die "The agos container is for $folder. Run ./agos reset to make one for this folder."
  fi
  docker exec "$CONTAINER" test -f /ws/agos ||
    die "The agos container was made for another folder. Run ./agos reset to make one for this folder."
  # Linux desktop: let the container (it runs as you) open windows
  if [ ! -e /dev/dxg ] && [ -n "${DISPLAY:-}" ] && command -v xhost > /dev/null 2>&1; then
    xhost +si:localuser:"$(id -un)" > /dev/null 2>&1
  fi
  return 0
}

in_docker() {
  docker_up
  local tty=()
  [ -t 0 ] && [ -t 1 ] && tty=(-it)
  exec docker exec "${tty[@]}" -e AGOS_DOCKER=0 "$CONTAINER" bash /ws/agos "$@"
}

# ----------------------------------------------------------------- ROS side

ros_env() {
  # ROS setup scripts are not written for "set -u"
  set +u
  # (ROS_DISTRO alone proves nothing: the ROS Docker images set it without
  # sourcing anything)
  if ! command -v ros2 > /dev/null 2>&1 || [ -z "${AMENT_PREFIX_PATH:-}" ]; then
    local d
    for d in ${ROS_DISTRO:-} lyrical kilted jazzy; do
      if [ -f "/opt/ros/$d/setup.bash" ]; then source "/opt/ros/$d/setup.bash"; break; fi
    done
    command -v ros2 > /dev/null 2>&1 || die "ROS 2 is not installed (no /opt/ros/<distro>/setup.bash)."
  fi
  # (only a build made by ./agos with this ROS and Python: one copied from
  # another computer points at that computer's folders)
  if [ -f "$WS/install/setup.bash" ] &&
     [ "$(cat "$WS/install/.agos_build_stamp" 2> /dev/null)" = "$(build_id)" ]; then
    source "$WS/install/setup.bash"
  fi
  # Qt (RViz) wants this folder to exist
  if [ -n "${XDG_RUNTIME_DIR:-}" ]; then mkdir -p -m 700 "$XDG_RUNTIME_DIR" 2> /dev/null; fi
  gpu_env
  return 0
}

gpu_env() {
  # WSL: Mesa can pick software rendering (llvmpipe) although a Windows GPU
  # is there (seen with Mesa 26). Its D3D12 driver reaches any GPU with a
  # Windows driver for WSL (NVIDIA, AMD or Intel), so use it when a test
  # shows it works. Which GPU: MESA_D3D12_DEFAULT_ADAPTER_NAME (docker_up).
  # LIBGL_ALWAYS_SOFTWARE=1 or a GALLIUM_DRIVER of your own still wins.
  # (Linux without WSL: Mesa picks the GPU itself through /dev/dri.)
  [ -e /dev/dxg ] && [ -z "${GALLIUM_DRIVER:-}" ] && [ -z "${LIBGL_ALWAYS_SOFTWARE:-}" ] || return 0
  command -v glxinfo > /dev/null 2>&1 || return 0
  if GALLIUM_DRIVER=d3d12 glxinfo -B 2> /dev/null | grep -q "renderer string: D3D12"; then
    export GALLIUM_DRIVER=d3d12
  fi
  return 0
}

# What ROS and Python a build is for (kept in install/.agos_build_stamp): a
# build made outside Docker does not work inside it, or the other way round,
# unless both have the same ROS and Python.
build_id() {
  printf '%s %s\n' "${ROS_DISTRO:-ros}" \
    "$(python3 -c 'import sys; print("python%d.%d" % sys.version_info[:2])' 2> /dev/null)"
}

needs_build() {
  local stamp="$WS/install/.agos_build_stamp"
  [ -f "$stamp" ] || return 0
  [ -f "$WS/install/$PKG/share/$PKG/package.xml" ] || return 0
  [ "$(cat "$stamp")" = "$(build_id)" ] || return 0
  [ -n "$(find "$WS/$PKG" -newer "$stamp" -not -path '*/__pycache__*' -not -name '*.pyc' -print -quit)" ]
}

build() {
  ros_env
  cd "$WS" || exit 1
  if [ "${1:-}" = "--clean" ]; then
    say "Deleting build/ install/ log/"
    rm -rf "$WS/build" "$WS/install" "$WS/log"
    shift
  fi
  local stamp="$WS/install/.agos_build_stamp"
  if [ -s "$stamp" ] && [ "$(cat "$stamp")" != "$(build_id)" ]; then
    warn "build/ and install/ are for $(cat "$stamp"), not $(build_id): building again from clean."
    rm -rf "$WS/build" "$WS/install" "$WS/log"
  fi
  local old=0
  if [ -e "$WS/build" ] || [ -e "$WS/install" ]; then old=1; fi
  say "Building $PKG"
  if ! colcon build --packages-select "$PKG" "$@"; then
    # An old build in the way: one made with --symlink-install ("File
    # exists"), or one copied from another computer (links to its folders,
    # "No such file"). Start again from a clean workspace, once.
    [ "$old" = 1 ] || die "Build failed (see the messages above)"
    warn "Build failed over the old build/ and install/. Deleting them and building again."
    rm -rf "$WS/build" "$WS/install" "$WS/log"
    colcon build --packages-select "$PKG" "$@" || die "Build failed (see the messages above)"
  fi
  build_id > "$WS/install/.agos_build_stamp"
  source "$WS/install/setup.bash"    # pick up the new install in this shell
}

ensure_built() {
  ros_env
  if needs_build; then build; fi
}

graphics_check() {
  # Gazebo, RViz and the robot's camera all draw with OpenGL. Without a GPU
  # (software rendering, "llvmpipe") everything runs several times slower.
  command -v glxinfo > /dev/null 2>&1 || return 0
  local renderer
  renderer=$(glxinfo -B 2>/dev/null | sed -n 's/.*OpenGL renderer string: //p')
  [ -n "$renderer" ] || return 0
  case "$renderer" in
    *llvmpipe*|*softpipe*|*SWR*)
      warn "Graphics: $renderer = software rendering (no GPU). Gazebo and RViz will be slow."
      if [ -e /dev/dxg ] || [ -d /usr/lib/wsl ]; then
        warn "  On Windows: update the graphics driver and WSL (wsl --update in PowerShell)."
      fi
      return 1 ;;
    *) say "Graphics: $renderer" ;;
  esac
}

launch() {
  if sim_running; then
    warn "A simulation is still running (an earlier start, or a closed window). Stopping it first."
    stop_all
  fi
  ensure_built
  graphics_check
  export AGOS_MISSION_DIR="${AGOS_MISSION_DIR:-$WS/missions}"
  say "Starting: ros2 launch $PKG agos.launch.py $*"
  say "Stop with Ctrl+C (or ./agos stop in another terminal)."
  exec ros2 launch "$PKG" agos.launch.py "$@"
}

# Everything a start can leave running
SIM_PROCESSES=("ros2 launch $PKG" "$PKG/explorer" "$PKG/nav_supervisor" "$PKG/odom_gps"
               "$PKG/imu_level" "teleop_twist_keyboard"
               "gz sim" "rviz2" "rtabmap" "parameter_bridge" "robot_state_publisher"
               "ekf_node" "controller_server" "planner_server" "smoother_server"
               "behavior_server" "bt_navigator" "waypoint_follower" "velocity_smoother"
               "lifecycle_manager")

# The AGOS-specific ones: is a simulation (or what is left of one) running?
sim_running() {
  pgrep -f -- "ros2 launch $PKG|$PKG/explorer|$PKG/nav_supervisor|gz sim|rtabmap" > /dev/null 2>&1
}

stop_all() {
  local p i
  # Ctrl+C for the launch first: it stops its nodes in order, and RTAB-Map
  # saves its map. The Gazebo server is told too: it can outlive its launcher.
  pkill -INT -f -- "ros2 launch $PKG" 2> /dev/null
  pkill -INT -f -- "gz sim" 2> /dev/null
  for i in $(seq 1 30); do
    sim_running || break
    [ "$i" = 5 ] && say "Waiting for everything to stop (RTAB-Map saves its map)..."
    sleep 1
  done
  for p in "${SIM_PROCESSES[@]}"; do pkill -INT -f -- "$p" 2> /dev/null; done
  sleep 1
  for p in "${SIM_PROCESSES[@]}"; do pkill -KILL -f -- "$p" 2> /dev/null; done
  say "Stopped"
}

check() {
  local ok=0 missing=()
  ros_env
  say "ROS 2: $ROS_DISTRO"
  if command -v gz > /dev/null 2>&1; then
    say "Gazebo: $(gz sim --versions 2>/dev/null | tail -n 1)"
  else
    warn "Gazebo (gz) not found"; ok=1
  fi
  local p have optional=()
  have=" $(ros2 pkg list 2> /dev/null | tr '\n' ' ') "
  for p in ros_gz_sim ros_gz_bridge robot_state_publisher robot_localization xacro rviz2 \
           rtabmap_slam nav2_controller nav2_mppi_controller nav2_planner nav2_smac_planner \
           nav2_smoother nav2_behaviors nav2_bt_navigator nav2_waypoint_follower \
           nav2_velocity_smoother nav2_lifecycle_manager nav2_rviz_plugins; do
    case "$have" in *" $p "*) ;; *) missing+=("$p") ;; esac
  done
  for p in rtabmap_viz teleop_twist_keyboard; do      # only for rtabmap_viz:=true / ./agos teleop
    case "$have" in *" $p "*) ;; *) optional+=("$p") ;; esac
  done
  if [ ${#missing[@]} -gt 0 ]; then
    warn "Missing ROS packages: ${missing[*]}"
    warn "  Install: sudo apt install $(printf "ros-$ROS_DISTRO-%s " "${missing[@]//_/-}")"
    ok=1
  else
    say "ROS packages: all there"
  fi
  if [ ${#optional[@]} -gt 0 ]; then
    say "Not installed (optional): ${optional[*]}"
    say "  Install: sudo apt install $(printf "ros-$ROS_DISTRO-%s " "${optional[@]//_/-}")"
  fi
  if needs_build; then say "Workspace: needs building (./agos build)"; else say "Workspace: built"; fi
  graphics_check || ok=1
  say "CPU cores: $(nproc), memory: $(free -g 2>/dev/null | awk '/Mem:/ {print $2 " GB"}')"
  return $ok
}

# ----------------------------------------------------------------- commands

cmd="${1:-help}"
[ $# -gt 0 ] && shift

case "$cmd" in
  help|-h|--help) usage; exit 0 ;;
esac

if use_docker; then
  case "$cmd" in
    image) docker_image --rebuild; exit 0 ;;
    reset)
      docker rm -f "$CONTAINER" > /dev/null 2>&1
      docker_up
      say "Fresh container ready"
      exit 0 ;;
    stop)
      docker exec "$CONTAINER" bash /ws/agos stop 2> /dev/null
      exit 0 ;;
    *) in_docker "$cmd" "$@" ;;
  esac
fi

case "$cmd" in
  start)   launch "$@" ;;
  explore)
    # ./agos explore full: the whole network instead of 25 m each way
    case "${1:-}" in
      full|all) shift; launch explore:=true explore_mode:=full "$@" ;;
      legs) shift; launch explore:=true "$@" ;;
      *) launch explore:=true "$@" ;;
    esac ;;
  mission)
    ensure_built
    export AGOS_MISSION_DIR="${AGOS_MISSION_DIR:-$WS/missions}"
    mode=legs
    case "${1:-}" in full|all) mode=full; shift ;; legs) shift ;; esac
    # (wall clock on purpose: it reads the simulation time from /tf)
    exec ros2 run "$PKG" explorer --ros-args -p use_sim_time:=false -p mode:=$mode "$@" ;;
  teleop)
    ros_env
    say "Keyboard driving: i forwards, , backwards, j/l turn, k stop (keep this window focused)"
    exec ros2 run teleop_twist_keyboard teleop_twist_keyboard "$@" ;;
  stop)    stop_all ;;
  shell)
    ensure_built
    say "ROS $ROS_DISTRO and the workspace are ready in this shell (exit to leave)"
    exec bash --rcfile <(printf 'source ~/.bashrc 2>/dev/null\nsource "%s/install/setup.bash"\nPS1="(agos) $PS1"\n' "$WS") -i ;;
  build)   build "$@" ;;
  check)   check ;;
  ros2)    ensure_built; exec ros2 "$@" ;;
  image|reset) die "\"$cmd\" is for Docker; ROS 2 is installed here, so Docker is not used" ;;
  *) warn "Unknown command: $cmd"; usage; exit 1 ;;
esac
