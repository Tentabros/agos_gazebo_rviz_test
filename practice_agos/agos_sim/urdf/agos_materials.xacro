<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Colours of the CAD parts (read from the per-face colours stored in
       Designs/STL/AGOS V1.stl) -->
  <material name="agos_body_grey">
    <color rgba="0.62 0.62 0.63 1.0"/>
  </material>
  <material name="agos_tread_red">
    <color rgba="0.74 0.19 0.13 1.0"/>
  </material>
  <material name="agos_accent_yellow">
    <color rgba="0.90 0.68 0.13 1.0"/>
  </material>
  <material name="agos_light_grey">
    <color rgba="0.94 0.94 0.93 1.0"/>
  </material>
  <material name="agos_green_body">
    <color rgba="0.26 0.58 0.26 1.0"/>
  </material>
  <material name="agos_sensor_dark">
    <color rgba="0.08 0.08 0.08 1.0"/>
  </material>

</robot>
