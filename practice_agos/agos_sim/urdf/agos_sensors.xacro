<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Sensor positions are taken from Designs/STL/AGOS V1.stl. The sensors'
       shapes are already part of the chassis mesh, so these links only carry
       frames, a small mass and the Gazebo sensor definitions. -->

  <!-- ===================== Orbbec front-facing RGB-D camera ===================== -->
  <xacro:macro name="agos_camera">
    <link name="camera_link">
      <inertial>
        <mass value="0.12"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.0002" ixy="0.0" ixz="0.0" iyy="0.0002" iyz="0.0" izz="0.0002"/>
      </inertial>
    </link>

    <!-- Centre of the lens panel on the CAD camera, on top of the front of the lid -->
    <joint name="camera_joint" type="fixed">
      <parent link="chassis_link"/>
      <child link="camera_link"/>
      <origin xyz="0.331 0 0.2465" rpy="0 0 0"/>
    </joint>

    <!-- Optical frame: images/pointclouds must be stamped z-forward/x-right/y-down -->
    <link name="camera_optical_frame"/>
    <joint name="camera_optical_joint" type="fixed">
      <parent link="camera_link"/>
      <child link="camera_optical_frame"/>
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <!-- Keep camera_link as its own link in Gazebo so the headlight below
         stays at the camera instead of being merged into the chassis. -->
    <gazebo reference="camera_joint">
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>

    <!-- Publishes (after ros_gz_bridge remap in config/bridge.yaml):
         /camera/image_raw, /camera/depth/image_raw, /camera/depth/points -->
    <gazebo reference="camera_link">
      <sensor name="orbbec_rgbd_camera" type="rgbd_camera">
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
        <topic>camera</topic>
        <gz_frame_id>camera_optical_frame</gz_frame_id>
        <camera>
          <horizontal_fov>1.204</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>8.0</far>
          </clip>
        </camera>
      </sensor>

      <!-- Front LED headlight (the proposal's high-intensity front LED).
           Without it the inside of the pipe is lit by ambient light only. -->
      <light name="agos_headlight" type="spot">
        <pose>0.03 0 0 0 0 0</pose>
        <direction>1 0 0</direction>
        <diffuse>1.0 0.97 0.9 1</diffuse>
        <specular>0.3 0.3 0.3 1</specular>
        <attenuation>
          <range>6.0</range>
          <constant>0.4</constant>
          <linear>0.1</linear>
          <quadratic>0.02</quadratic>
        </attenuation>
        <spot>
          <inner_angle>0.5</inner_angle>
          <outer_angle>1.1</outer_angle>
          <falloff>1.0</falloff>
        </spot>
        <cast_shadows>false</cast_shadows>
      </light>
    </gazebo>
  </xacro:macro>

  <!-- ===================== Okdo LD06 2D LiDAR ===================== -->
  <xacro:macro name="agos_lidar">
    <link name="lidar_link">
      <inertial>
        <mass value="0.05"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
      </inertial>
    </link>

    <!-- Scan plane of the LD06 on top of the lid (CAD LiDAR body: z 0.265-0.298).
         It sits 1 cm above the top of the camera, so the camera does not block it. -->
    <joint name="lidar_joint" type="fixed">
      <parent link="chassis_link"/>
      <child link="lidar_link"/>
      <origin xyz="0 0 0.287" rpy="0 0 0"/>
    </joint>

    <gazebo reference="lidar_link">
      <sensor name="okdo_2d_lidar" type="gpu_lidar">
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <topic>scan</topic>
        <gz_frame_id>lidar_link</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.12</min>
            <max>10.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- ===================== 9-DOF IMU ===================== -->
  <xacro:macro name="agos_imu">
    <link name="imu_link">
      <inertial>
        <mass value="0.05"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.00002" ixy="0.0" ixz="0.0" iyy="0.00002" iyz="0.0" izz="0.00002"/>
      </inertial>
    </link>

    <!-- Inside the body, at the CAD origin -->
    <joint name="imu_joint" type="fixed">
      <parent link="chassis_link"/>
      <child link="imu_link"/>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
    </joint>

    <!-- Requires the gz-sim-imu-system world plugin (in worlds/agos_pipe.sdf
         and worlds/agos_world.sdf) or this topic stays silent. -->
    <gazebo reference="imu_link">
      <sensor name="agos_imu" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <topic>imu/data</topic>
        <gz_frame_id>imu_link</gz_frame_id>
      </sensor>
    </gazebo>
  </xacro:macro>

</robot>
