<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Each track is modelled as driven wheel cylinders where the real track
       touches things (cheap and stable). They have no visual: the track you
       see is the CAD mesh on chassis_link.
         4 road wheels  : the CAD rollers, bottoms on the ground (z = 0)
         2 idler wheels : the raised front/rear ends of the track, so the
                          robot can climb onto lips, debris and pipe walls -->
  <xacro:macro name="agos_wheel" params="side y_sign pos x z mu">
    <link name="${side}_wheel_${pos}">
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${track_width}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia
          ixx="${(wheel_mass/12.0)*(3*wheel_radius*wheel_radius + track_width*track_width)}" ixy="0.0" ixz="0.0"
          iyy="${(wheel_mass/2.0)*wheel_radius*wheel_radius}" iyz="0.0"
          izz="${(wheel_mass/12.0)*(3*wheel_radius*wheel_radius + track_width*track_width)}"/>
      </inertial>
    </link>

    <joint name="${side}_wheel_${pos}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel_${pos}"/>
      <origin xyz="${x} ${y_sign * track_y} ${z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.1" friction="0.05"/>
    </joint>

    <gazebo reference="${side}_wheel_${pos}">
      <mu1>${mu}</mu1>
      <mu2>${mu}</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="agos_track" params="side y_sign">
    <!-- Outer road wheels slide sideways easily (mu 0.05) so the robot can
         skid-steer; the two middle ones carry the grip (mu 1.0). -->
    <xacro:agos_wheel side="${side}" y_sign="${y_sign}" pos="idler_front" x="0.29"    z="-0.05"       mu="0.8"/>
    <xacro:agos_wheel side="${side}" y_sign="${y_sign}" pos="road_1"      x="0.2029"  z="${wheel_z}" mu="0.05"/>
    <xacro:agos_wheel side="${side}" y_sign="${y_sign}" pos="road_2"      x="0.0759"  z="${wheel_z}" mu="1.0"/>
    <xacro:agos_wheel side="${side}" y_sign="${y_sign}" pos="road_3"      x="-0.0511" z="${wheel_z}" mu="1.0"/>
    <xacro:agos_wheel side="${side}" y_sign="${y_sign}" pos="road_4"      x="-0.2058" z="${wheel_z}" mu="0.05"/>
    <xacro:agos_wheel side="${side}" y_sign="${y_sign}" pos="idler_rear"  x="-0.29"   z="-0.05"       mu="0.8"/>
  </xacro:macro>

  <!-- Differential Drive Plugin: every wheel on a side turns together, like a track -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_idler_front_joint</left_joint>
      <left_joint>left_wheel_road_1_joint</left_joint>
      <left_joint>left_wheel_road_2_joint</left_joint>
      <left_joint>left_wheel_road_3_joint</left_joint>
      <left_joint>left_wheel_road_4_joint</left_joint>
      <left_joint>left_wheel_idler_rear_joint</left_joint>
      <right_joint>right_wheel_idler_front_joint</right_joint>
      <right_joint>right_wheel_road_1_joint</right_joint>
      <right_joint>right_wheel_road_2_joint</right_joint>
      <right_joint>right_wheel_road_3_joint</right_joint>
      <right_joint>right_wheel_road_4_joint</right_joint>
      <right_joint>right_wheel_idler_rear_joint</right_joint>
      <wheel_separation>${track_separation * skid_factor}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>/model/agos/tf_odom_raw</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
    <!-- Wheel angles for robot_state_publisher. Without update_rate this
         publishes on every physics step (500-1000 times a second), and each
         message becomes 12 wheel transforms on /tf that every ROS node
         listening to /tf has to process. 20 Hz is plenty: the wheels have no
         visual of their own. -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <update_rate>20</update_rate>
    </plugin>
  </gazebo>

</robot>
