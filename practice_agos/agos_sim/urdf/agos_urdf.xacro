<?xml version="1.0"?>
<robot name="agos" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================== Dimensions =====================
       Measured from the CAD export Designs/STL/AGOS V1.stl (Fusion, mm).
       The CAD model faces +y; here it is rotated so +x is forward, and scaled
       to metres. base_link sits at the CAD origin, 0.178 m above the ground.
         Body envelope : 0.711 L x 0.381 W x 0.476 H (ground to top of LiDAR)
         Tracks        : 0.042 wide tread, centred 0.1436 m either side,
                         flat contact patch from x = -0.21 to +0.21
         Road wheels   : 4 rollers per side inside each track
         The tether tube out of the back of the CAD model is left out of the
         meshes (tools/convert_robot_stl.py): it is a cable, not a rigid part.
       The meshes in meshes/agos_*.stl are a simplified copy of that CAD file
       (see tools/convert_robot_stl.py). -->

  <!-- Track / wheels -->
  <xacro:property name="ground_to_base"   value="0.178"/>   <!-- ground -> base_link -->
  <xacro:property name="track_y"          value="0.1436"/>  <!-- track centre, either side -->
  <xacro:property name="track_width"      value="0.042"/>
  <xacro:property name="track_separation" value="${2*track_y}"/>
  <!-- A tracked robot skids sideways when it turns, so it turns less than
       its track speeds say: in Gazebo it turns 0.77x as far as plain
       diff-drive maths predicts. DiffDrive uses this wider "effective" track
       separation (0.287 m / 0.77) so a commanded turn rate is what the robot
       really does, and /odom reports the turn it really made. Re-measure if
       you change the wheels or their friction. -->
  <xacro:property name="skid_factor"      value="1.30"/>
  <xacro:property name="wheel_radius"     value="0.0385"/>
  <xacro:property name="wheel_z"          value="${wheel_radius - ground_to_base}"/>
  <xacro:property name="wheel_mass"       value="0.25"/>

  <!-- Chassis -->
  <xacro:property name="chassis_length" value="0.66"/>
  <xacro:property name="chassis_width"  value="0.381"/>  <!-- overall, incl. tracks -->
  <xacro:property name="chassis_height" value="0.40"/>
  <xacro:property name="chassis_mass"   value="15.0"/>

  <xacro:include filename="$(find agos_sim)/urdf/agos_materials.xacro"/>
  <xacro:include filename="$(find agos_sim)/urdf/agos_tracks.xacro"/>
  <xacro:include filename="$(find agos_sim)/urdf/agos_sensors.xacro"/>

  <!-- One coloured part of the CAD model (already in metres, +x forward) -->
  <xacro:macro name="agos_mesh_visual" params="part material">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://agos_sim/meshes/agos_${part}.stl"/>
      </geometry>
      <material name="${material}"/>
    </visual>
  </xacro:macro>

  <!-- ===================== base_footprint -> base_link -> chassis_link ===================== -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${ground_to_base}" rpy="0 0 0"/>
  </joint>

  <link name="base_link"/>

  <joint name="base_link_to_chassis" type="fixed">
    <parent link="base_link"/>
    <child link="chassis_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="chassis_link">

    <!-- Visual: the CAD model, split by its colours -->
    <xacro:agos_mesh_visual part="body"    material="agos_body_grey"/>
    <xacro:agos_mesh_visual part="treads"  material="agos_tread_red"/>
    <xacro:agos_mesh_visual part="accents" material="agos_accent_yellow"/>
    <xacro:agos_mesh_visual part="light"   material="agos_light_grey"/>
    <xacro:agos_mesh_visual part="green"   material="agos_green_body"/>
    <xacro:agos_mesh_visual part="dark"    material="agos_sensor_dark"/>

    <!-- Collision: simple boxes that follow the body's cross-section (lid
         0.28 m wide on top, narrowing to the belly between the tracks). The
         tracks' ground contact is carried by the wheel cylinders in
         agos_tracks.xacro. -->
    <!-- Lid and upper hull -->
    <collision>
      <origin xyz="0 0 0.1543" rpy="0 0 0"/>
      <geometry><box size="${chassis_length} 0.28 0.1486"/></geometry>
    </collision>
    <!-- Lower hull and belly between the tracks -->
    <collision>
      <origin xyz="0 0 -0.01" rpy="0 0 0"/>
      <geometry><box size="0.62 0.22 0.18"/></geometry>
    </collision>
    <!-- Camera housing on the front of the lid -->
    <collision>
      <origin xyz="0.3066 0 0.2400" rpy="0 0 0"/>
      <geometry><box size="0.099 0.165 0.074"/></geometry>
    </collision>
    <!-- LiDAR and its pedestal -->
    <collision>
      <origin xyz="0 0 0.2508" rpy="0 0 0"/>
      <geometry><cylinder radius="0.04" length="0.0952"/></geometry>
    </collision>

    <inertial>
      <mass value="${chassis_mass}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
        ixx="${(chassis_mass/12.0)*(chassis_width*chassis_width + chassis_height*chassis_height)}" ixy="0.0" ixz="0.0"
        iyy="${(chassis_mass/12.0)*(chassis_length*chassis_length + chassis_height*chassis_height)}" iyz="0.0"
        izz="${(chassis_mass/12.0)*(chassis_length*chassis_length + chassis_width*chassis_width)}"/>
    </inertial>
  </link>

  <!-- ===================== Tracks ===================== -->
  <xacro:agos_track side="left"  y_sign="1"/>
  <xacro:agos_track side="right" y_sign="-1"/>

  <!-- ===================== Sensors ===================== -->
  <xacro:agos_camera/>
  <xacro:agos_lidar/>
  <xacro:agos_imu/>

</robot>
