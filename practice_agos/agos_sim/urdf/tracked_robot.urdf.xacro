<?xml version="1.0"?>

<robot xmlns:xacro="[http://www.ros.org/wiki/xacro](http://www.ros.org/wiki/xacro)" name="lyrical_tracked_robot">


<!-- Materials -->

<material name="chassis_color">

<color rgba="0.2 0.2 0.2 1.0"/>

</material>

<material name="track_color">

<color rgba="0.05 0.05 0.05 1.0"/>

</material>



<!-- Dummy Base Link to prevent KDL errors -->

<link name="base_footprint"/>



<!-- Chassis Link -->

<link name="base_link">

<visual>

<origin xyz="0 0 0.1" rpy="0 0 0"/>

<geometry>

<!-- Standard box representation of the track chassis -->

<box size="0.5 0.3 0.15"/>

</geometry>

<material name="chassis_color"/>

</visual>

<collision>

<origin xyz="0 0 0.1" rpy="0 0 0"/>

<geometry>

<box size="0.5 0.3 0.15"/>

</geometry>

</collision>

<inertial>

<mass value="15.0"/>

<origin xyz="0 0 0.1" rpy="0 0 0"/>

<inertia ixx="0.14" ixy="0.0" ixz="0.0" iyy="0.34" iyz="0.0" izz="0.42"/>

</inertial>

</link>



<joint name="base_footprint_joint" type="fixed">

<parent link="base_footprint"/>

<child link="base_link"/>

<origin xyz="0 0 0" rpy="0 0 0"/>

</joint>



<!-- Track Macro for Left and Right Assembly -->

<!-- Note: ROS 2 Lyrical URDF 1.2 supports 'quat_xyzw' for orientation alongside rpy -->

<xacro:macro name="track_assembly" params="side reflect">


<!-- Visual representation of the track belt itself (Static to the base) -->

<link name="${side}_track_belt">

<visual>

<origin xyz="0 0 0.08" rpy="0 0 0"/>

<geometry>

<!-- Using standard box to visually frame the belt; replace with your mesh if needed -->

<box size="0.6 0.06 0.16"/>

</geometry>

<material name="track_color"/>

</visual>

<collision>

<origin xyz="0 0 0.08" rpy="0 0 0"/>

<geometry>

<box size="0.6 0.06 0.16"/>

</geometry>

</collision>

<inertial>

<mass value="2.0"/>

<inertia ixx="0.005" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>

</inertial>

</link>



<joint name="${side}_track_joint" type="fixed">

<parent link="base_link"/>

<child link="${side}_track_belt"/>

<origin xyz="0 ${reflect * 0.18} 0" rpy="0 0 0"/>

</joint>



<!-- Drive Sprocket / Primary Wheel (Simulates Track Kinematics via diff-drive physics) -->

<link name="${side}_drive_wheel">

<visual>

<origin xyz="0 0 0" rpy="1.5708 0 0"/>

<geometry>

<cylinder radius="0.08" length="0.06"/>

</geometry>

<material name="chassis_color"/>

</visual>

<collision>

<origin xyz="0 0 0" rpy="1.5708 0 0"/>

<geometry>

<cylinder radius="0.08" length="0.06"/>

</geometry>

</collision>

<inertial>

<mass value="1.5"/>

<inertia ixx="0.0024" ixy="0.0" ixz="0.0" iyy="0.0024" iyz="0.0" izz="0.0048"/>

</inertial>

</link>



<!-- Continuous joint allows rotation for wheel/sprocket simulation -->

<joint name="${side}_drive_wheel_joint" type="continuous">

<parent link="${side}_track_belt"/>

<child link="${side}_drive_wheel"/>

<origin xyz="0 0 0.08" rpy="0 0 0"/>

<axis xyz="0 1 0"/>

</joint>

</xacro:macro>



<!-- Instantiate Left and Right Tracks -->

<xacro:track_assembly side="left" reflect="1"/>

<xacro:track_assembly side="right" reflect="-1"/>


<!-- Gazebo Differential Drive & Joint State Plugins -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_drive_wheel_joint</left_joint>
      <right_joint>right_drive_wheel_joint</right_joint>
      <wheel_separation>0.36</wheel_separation>
      <wheel_radius>0.08</wheel_radius>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_linear_acceleration>-1.0</min_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <min_angular_acceleration>-2.0</min_angular_acceleration>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </gazebo>


</robot>