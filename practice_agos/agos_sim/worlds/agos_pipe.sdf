<?xml version="1.0"?>
<sdf version="1.10">
  <world name="agos_pipe">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <gravity>0 0 -9.8</gravity>

    <!-- Ambient light is what lights the inside of the pipe (the sun is
         shadowed there); the robot also carries a front headlight. -->
    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.7 0.8 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Pipe from Designs/STL/PipeDesign_AGOS.stl scaled up 2.25x, so its
         400 mm bore becomes the 900 mm of the sewer pipes AGOS is built for:
         same shape and open ends, 15.5 m long, 1.37 m bends, 100 mm wall.
         The mesh rests on the ground (z = 0 is the ground, the bottom inside
         the pipe is at z = 0.1). The world origin is the middle of the longest
         straight (2.74 m), where the robot spawns facing +x.
         Regenerate with tools/make_pipe_mesh.py and tools/make_pipe_texture.py.
         The .obj is drawn (it carries the texture coordinates), the .stl
         collides. -->
    <model name="agos_pipe">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="pipe_collision">
          <geometry>
            <mesh><uri>model://agos_sim/meshes/agos_pipe.stl</uri></mesh>
          </geometry>
          <surface>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="pipe_visual">
          <geometry>
            <mesh><uri>model://agos_sim/meshes/agos_pipe.obj</uri></mesh>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
            <pbr>
              <metal>
                <albedo_map>model://agos_sim/materials/textures/pipe_concrete.jpg</albedo_map>
                <normal_map>model://agos_sim/materials/textures/pipe_concrete_normal.jpg</normal_map>
                <roughness>0.9</roughness>
                <metalness>0.0</metalness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
