<?xml version="1.0"?>
<sdf version="1.10">
  <world name="agos_pipe">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <gravity>0 0 -9.8</gravity>

    <!-- Ambient light is what lights the inside of the pipe (the sun is
         shadowed there); the robot also carries a front headlight. -->
    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.7 0.8 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Pipe from Designs/STL/PipeDesign_AGOS.stl: same path, bends and open
         ends, but with a 600 mm bore and a 100 mm wall (the CAD file has a
         400 mm bore, which the 381 x 476 mm robot cannot fit through).
         Regenerate with tools/make_pipe_mesh.py.
         Pose: pipe axis 0.4 m above the ground (bore/2 + wall), so the pipe
         rests on the ground. The world origin is the middle of the longest
         straight (1.22 m), which is where the robot spawns, facing +x. -->
    <model name="agos_pipe">
      <static>true</static>
      <pose>0 0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <mesh><uri>model://agos_sim/meshes/agos_pipe.stl</uri></mesh>
          </geometry>
          <surface>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <mesh><uri>model://agos_sim/meshes/agos_pipe.stl</uri></mesh>
          </geometry>
          <material>
            <ambient>0.80 0.80 0.78 1</ambient>
            <diffuse>0.80 0.80 0.78 1</diffuse>
            <specular>0.10 0.10 0.10 1</specular>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
