Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: odom
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Axes: true
      Show Names: false
      Marker Scale: 0.3
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan (/scan)
      Enabled: true
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Style: Flat Squares
      Size (m): 0.05
      Alpha: 1
      Decay Time: 0
      Color Transformer: FlatColor
      Color: 255; 40; 40
    - Class: rviz_default_plugins/Odometry
      Name: Odometry (/odom)
      Enabled: true
      Topic:
        Value: /odom
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Keep: 50
      Shape:
        Value: Arrow
        Alpha: 1
        Head Length: 0.15
        Head Radius: 0.05
        Shaft Length: 0.2
        Shaft Radius: 0.02
        Color: 255; 255; 0
    - Class: rviz_default_plugins/Image
      Name: Camera (/camera/image_raw)
      Enabled: true
      Topic:
        Value: /camera/image_raw
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
    - Class: rviz_default_plugins/PointCloud2
      Name: Depth points
      Enabled: false
      Topic:
        Value: /camera/depth/points
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
      Axis: Z
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Target Frame: <Fixed Frame>
      Distance: 4
      Pitch: 0.8
      Yaw: 0.8