<?xml version="1.0"?>
<robot name="agos" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================== Dimensions =====================
       Envelope: 660.4 x 279.4 x 406.4 mm (L x W x H), excluding LiDAR and pole.
       Lower half = tracks, upper half = body. Assumes chassis_height = 4*track_radius. -->
  <xacro:property name="chassis_length" value="0.6604"/>
  <xacro:property name="chassis_width"  value="0.2794"/>
  <xacro:property name="chassis_height" value="0.4064"/>
  <xacro:property name="chassis_mass"   value="42.0"/>

  <xacro:property name="track_radius"     value="0.1016"/>
  <xacro:property name="track_width"      value="0.08"/>
  <xacro:property name="wheel_mass"       value="1.2"/>
  <xacro:property name="track_separation" value="${chassis_width - track_width}"/>
  <xacro:property name="wheel_x_offset"   value="${chassis_length/2 - track_radius}"/>
  <xacro:property name="track_mu"         value="0.4"/>

  <!-- Body above the tracks, measured from the track top -->
  <xacro:property name="body_height"   value="${chassis_height/2}"/>
  <xacro:property name="lidar_mount_h" value="0.07"/>
  <xacro:property name="whip_length"   value="0.35"/>

  <xacro:include filename="$(find agos_sim)/urdf/agos_materials.xacro"/>
  <xacro:include filename="$(find agos_sim)/urdf/agos_tracks.xacro"/>
  <xacro:include filename="$(find agos_sim)/urdf/agos_sensors.xacro"/>

  <!-- ===================== base_footprint -> base_link -> chassis_link ===================== -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${track_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link"/>

  <!-- chassis_link origin = envelope center (ground + chassis_height/2 = track top) -->
  <joint name="base_link_to_chassis" type="fixed">
    <parent link="base_link"/>
    <child link="chassis_link"/>
    <origin xyz="0 0 ${chassis_height/2 - track_radius}" rpy="0 0 0"/>
  </joint>

  <link name="chassis_link">

    <!-- Green belly pan, between the tracks -->
    <visual>
      <origin xyz="0 0 ${0.12 - chassis_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length - 0.06} ${track_separation - track_width - 0.004} 0.12"/>
      </geometry>
      <material name="agos_green_body"/>
    </visual>

    <!-- Silver main body enclosure -->
    <visual>
      <origin xyz="0 0 ${(body_height - 0.01)/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length - 0.08} ${chassis_width - 0.02} ${body_height - 0.01}"/>
      </geometry>
      <material name="agos_silver_enclosure"/>
    </visual>

    <!-- Green top lid plate -->
    <visual>
      <origin xyz="0 0 ${body_height - 0.005}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length - 0.10} ${chassis_width - 0.04} 0.01"/>
      </geometry>
      <material name="agos_green_body"/>
    </visual>

    <!-- Front roll-cage arch -->
    <visual>
      <origin xyz="0.19 0 ${body_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 ${chassis_width} ${body_height + 0.01}"/>
      </geometry>
      <material name="agos_dark_grey_frame"/>
    </visual>

    <!-- Rear roll-cage arch -->
    <visual>
      <origin xyz="-0.19 0 ${body_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 ${chassis_width} ${body_height + 0.01}"/>
      </geometry>
      <material name="agos_dark_grey_frame"/>
    </visual>

    <!-- Rear whip pole / antenna (visual only) -->
    <visual>
      <origin xyz="${-chassis_length/2 - whip_length/2 + 0.05} 0 ${body_height/2}" rpy="0 ${pi/2} 0"/>
      <geometry>
        <cylinder radius="0.012" length="${whip_length}"/>
      </geometry>
      <material name="agos_sensor_dark"/>
    </visual>

    <!-- Yellow LiDAR pedestal (the LiDAR itself is in agos_sensors.xacro) -->
    <visual>
      <origin xyz="0 0 ${body_height + lidar_mount_h/2}" rpy="0 0 0"/>
      <geometry>
        <box size="0.10 0.10 ${lidar_mount_h}"/>
      </geometry>
      <material name="agos_lidar_yellow"/>
    </visual>

    <!-- Collision: upper body only. Tracks/wheels carry ground contact. -->
    <collision>
      <origin xyz="0 0 ${body_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length - 0.08} ${chassis_width} ${body_height}"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="${chassis_mass}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
        ixx="${(chassis_mass/12.0)*(chassis_width*chassis_width + chassis_height*chassis_height)}" ixy="0.0" ixz="0.0"
        iyy="${(chassis_mass/12.0)*(chassis_length*chassis_length + chassis_height*chassis_height)}" iyz="0.0"
        izz="${(chassis_mass/12.0)*(chassis_length*chassis_length + chassis_width*chassis_width)}"/>
    </inertial>
  </link>

  <!-- ===================== Tracks ===================== -->
  <xacro:agos_track side="left"  y_sign="1"/>
  <xacro:agos_track side="right" y_sign="-1"/>

  <!-- ===================== Sensors ===================== -->
  <xacro:agos_camera/>
  <xacro:agos_lidar/>
  <xacro:agos_imu/>

</robot>