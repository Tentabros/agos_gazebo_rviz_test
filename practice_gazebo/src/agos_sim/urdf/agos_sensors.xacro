<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================== Orbbec front-facing RGB-D camera ===================== -->
  <xacro:macro name="agos_camera">
    <xacro:property name="cam_size" value="0.045"/>
    <link name="camera_link">
      <visual>
        <geometry><box size="${cam_size} 0.09 ${cam_size}"/></geometry>
        <material name="agos_sensor_dark"/>
      </visual>
      <collision>
        <geometry><box size="${cam_size} 0.09 ${cam_size}"/></geometry>
      </collision>
      <inertial>
        <mass value="0.12"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.0002" ixy="0.0" ixz="0.0" iyy="0.0002" iyz="0.0" izz="0.0002"/>
      </inertial>
    </link>

    <joint name="camera_joint" type="fixed">
      <parent link="chassis_link"/>
      <child link="camera_link"/>
      <origin xyz="${chassis_length/2 + cam_size/2} 0 ${chassis_height*0.25}" rpy="0 0 0"/>
    </joint>

    <!-- Optical frame: images/pointclouds must be stamped z-forward/x-right/y-down -->
    <link name="camera_optical_frame"/>
    <joint name="camera_optical_joint" type="fixed">
      <parent link="camera_link"/>
      <child link="camera_optical_frame"/>
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <!-- Publishes (after ros_gz_bridge remap in config/bridge.yaml):
         /camera/image_raw and /camera/depth/points -->
    <gazebo reference="camera_link">
      <sensor name="orbbec_rgbd_camera" type="rgbd_camera">
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
        <topic>camera</topic>
        <gz_frame_id>camera_optical_frame</gz_frame_id>
        <camera>
          <horizontal_fov>1.204</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>8.0</far>
          </clip>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- ===================== Okdo 2D LiDAR ===================== -->
  <xacro:macro name="agos_lidar">
    <xacro:property name="lidar_radius" value="0.035"/>
    <xacro:property name="lidar_height" value="0.04"/>
    <link name="lidar_link">
      <visual>
        <geometry><cylinder radius="${lidar_radius}" length="${lidar_height}"/></geometry>
        <material name="agos_sensor_dark"/>
      </visual>
      <collision>
        <geometry><cylinder radius="${lidar_radius}" length="${lidar_height}"/></geometry>
      </collision>
      <inertial>
        <mass value="0.15"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
      </inertial>
    </link>

    <!-- Sits on the yellow pedestal defined in agos.urdf.xacro (lidar_mount_h) -->
    <joint name="lidar_joint" type="fixed">
      <parent link="chassis_link"/>
      <child link="lidar_link"/>
      <origin xyz="0 0 ${chassis_height/2 + lidar_mount_h + lidar_height/2}" rpy="0 0 0"/>
    </joint>

    <gazebo reference="lidar_link">
      <sensor name="okdo_2d_lidar" type="gpu_lidar">
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <topic>scan</topic>
        <gz_frame_id>lidar_link</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.12</min>
            <max>10.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- ===================== 9-DOF IMU ===================== -->
  <xacro:macro name="agos_imu">
    <link name="imu_link">
      <visual>
        <geometry><box size="0.03 0.03 0.01"/></geometry>
        <material name="agos_sensor_dark"/>
      </visual>
      <collision>
        <geometry><box size="0.03 0.03 0.01"/></geometry>
      </collision>
      <inertial>
        <mass value="0.05"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.00002" ixy="0.0" ixz="0.0" iyy="0.00002" iyz="0.0" izz="0.00002"/>
      </inertial>
    </link>

    <joint name="imu_joint" type="fixed">
      <parent link="chassis_link"/>
      <child link="imu_link"/>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
    </joint>

    <!-- Requires the gz-sim-imu-system world plugin (added in worlds/pvc_pipe.sdf)
         or this topic stays silent even though the sensor is declared here. -->
    <gazebo reference="imu_link">
      <sensor name="agos_imu" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <topic>imu/data</topic>
        <gz_frame_id>imu_link</gz_frame_id>
      </sensor>
    </gazebo>
  </xacro:macro>

</robot>